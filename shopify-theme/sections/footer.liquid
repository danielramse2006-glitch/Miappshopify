<footer class="bg-[#FAF6F6] text-stone-800 pt-16 pb-12 border-t border-stone-200/60 font-sans">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12 text-center md:text-left">
    
    <div class="space-y-4">
      <h3 class="font-serif text-2xl font-bold text-stone-950 leading-none">ModaBelle MX</h3>
      <p class="text-xs text-stone-500 leading-relaxed font-light">Distribuidor número uno de alta cosmética y lotes surtidos originales para emprendedoras en México.</p>
    </div>

    <div class="space-y-3">
      <h4 class="text-xs font-bold tracking-widest text-[#DC9C9B] uppercase font-mono">Enlaces</h4>
      <ul class="space-y-2 text-xs text-stone-600">
        <li><a href="#hero" class="hover:text-stone-900 transition">Inicio</a></li>
        <li><a href="#Catalogo" class="hover:text-stone-900 transition">Colecciones</a></li>
        <li><a href="#Nosotros" class="hover:text-stone-900 transition">Nosotros</a></li>
      </ul>
    </div>

    <div class="space-y-3">
      <h4 class="text-xs font-bold tracking-widest text-[#DC9C9B] uppercase font-mono">Soporte</h4>
      <ul class="space-y-2 text-xs text-stone-600">
        <li><a href="#FAQ" class="hover:text-stone-900 transition">Preguntas Frecuentes</a></li>
        <li><a href="#Contacto" class="hover:text-stone-900 transition">Contacto de WhatsApp</a></li>
        <li><a href="#Envios" class="hover:text-stone-900 transition">Políticas de Envío</a></li>
      </ul>
    </div>

    <div class="space-y-4">
      <h4 class="text-xs font-bold tracking-widest text-[#DC9C9B] uppercase font-mono">Newsletter</h4>
      <p class="text-xs text-stone-500 leading-relaxed font-light">Suscríbete para recibir alertas de nuevos lanzamientos y ofertas Hot Sale.</p>
      <form class="flex max-w-sm mx-auto md:mx-0">
        <input type="email" placeholder="Tu correo electrónico" class="flex-1 min-w-0 bg-white text-xs border border-stone-200 focus:outline-none focus:border-[#DC9C9B] rounded-l-xl px-4 py-3" required />
        <button type="submit" class="bg-stone-950 hover:bg-[#DC9C9B] text-white hover:text-stone-950 text-[10px] font-bold uppercase tracking-wider px-4 rounded-r-xl transition duration-300">Unirse</button>
      </form>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 pt-12 mt-12 border-t border-stone-200/40 flex flex-col md:flex-row items-center justify-between text-center md:text-left gap-4 text-[11px] text-stone-400">
    <p>© 2026 ModaBelle MX. Todos los derechos reservados. Mayoristas Certificados.</p>
    <div class="flex items-center gap-4">
      <span class="hover:text-[#DC9C9B] transition cursor-pointer">@modabelle.mx</span>
    </div>
  </div>
</footer>

