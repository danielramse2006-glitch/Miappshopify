<header class="bg-white border-b border-stone-100 px-6 md:px-12 py-4 flex items-center justify-between sticky top-0 z-10 font-sans shadow-xs">
  {/* Menu Toggle */}
  <div class="flex items-center gap-4">
    <button class="text-stone-900 hover:text-[#DC9C9B] transition" aria-label="Menu">
      <svg class="h-6 w-6 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  {/* Center Brand Logo */}
  <div class="text-center flex flex-col items-center">
    <a href="/" class="group flex flex-col items-center select-none text-stone-950 hover:opacity-90">
      <h1 class="font-serif text-2.5xl md:text-3.5xl font-normal tracking-wide text-stone-950 leading-none">
        ModaBelle
      </h1>
      <span class="font-sans text-[10px] md:text-[11px] font-bold tracking-[0.35em] text-stone-800 uppercase mt-2 leading-none pl-[0.35em]">
        MX
      </span>
    </a>
  </div>

  {/* Actions */}
  <div class="flex items-center gap-4 text-stone-900">
    <button class="hover:text-[#DC9C9B] transition" aria-label="Buscar">
      <svg class="h-5.5 w-5.5 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.602 10.602z" />
      </svg>
    </button>
    <a href="/cart" class="flex items-center gap-1.5 hover:text-[#DC9C9B] transition" aria-label="Carrito de compras">
      <svg class="h-5.5 w-5.5 stroke-[1.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
      </svg>
      <span class="text-xs font-bold font-mono">(0)</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
